# ─── XMBot — Full Stack Configuration ────────────────────────────────────────
# Copy this file to .env and fill in your values
#   cp .env.example .env
# Then start everything:
#   docker compose up -d

# ─── Web App ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Database (local Postgres from docker-compose — works out of the box)
DATABASE_URL=postgresql://xmbot:xmbot_dev@localhost:5432/xmbot

# CashFree Payment Gateway (get from https://merchant.cashfree.com)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=SANDBOX

# ─── Engine ──────────────────────────────────────────────────────────────────
DEFAULT_BROKER=paper
LOG_LEVEL=INFO

# Telegram (optional — signals print to console without this)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# AI Providers (optional — at least one needed for AI validation)
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=

# Risk limits
MAX_DAILY_LOSS=10000
MAX_POSITIONS=20
SIGNAL_TIMEOUT=300
