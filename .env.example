# ─── XMBot — Full Stack Configuration ────────────────────────────────────────
# Copy this file to .env and fill in your values
#   cp .env.example .env
# Then start everything:
#   docker compose up -d

# ─── Web App ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Database (local Postgres from docker-compose — works out of the box)
DATABASE_URL=postgresql://xmbot:xmbot_dev@localhost:5432/xmbot

# CashFree Payment Gateway (get from https://merchant.cashfree.com)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=SANDBOX

# ─── Engine ──────────────────────────────────────────────────────────────────
DEFAULT_BROKER=paper
# Set XMBOT_ENV=production only in the production secret/configuration store.
# Production startup requires XMBOT_API_KEY, DATABASE_URL, and ENCRYPTION_KEY
# and rejects the paper broker.
XMBOT_ENV=development
LOG_LEVEL=INFO

# Shared service credential used only between the web/platform API and engine.
# Generate independently from NEXTAUTH_SECRET; never embed it in web/mobile clients.
XMBOT_API_KEY=

# Binance (used when DEFAULT_BROKER=binance)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Set true to trade against https://testnet.binance.vision instead of
# production Binance — generate separate testnet API keys there.
BINANCE_TESTNET=false

# Telegram (optional — signals print to console without this)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# AI Providers (optional — at least one needed for AI validation)
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=

# Risk limits
MAX_DAILY_LOSS=10000
MAX_POSITIONS=20
SIGNAL_TIMEOUT=300

# ─── MQL5 ────────────────────────────────────────────────────────────────────
# MQL5 Community key (for Market access and Signals integration)
MQL5_COMMUNITY_KEY=

# ─── Encryption ──────────────────────────────────────────────────────────────
# Encryption key for broker credentials at rest (generate with: python -c "import secrets; print(secrets.token_hex(32))")
ENCRYPTION_KEY=
