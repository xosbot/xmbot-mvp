# XMBot Engine Configuration

# Environment
XMBOT_ENV=development

# Database
DATABASE_URL=postgresql://localhost:5432/xmbot
REDIS_URL=redis://localhost:6379/0

# Telegram (optional — without it, signals print to console)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Broker — set to "paper", "ibkr", or "mt5"
DEFAULT_BROKER=paper

# IBKR
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# MT5
MT5_PATH=
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=

# AI Providers (optional)
CLAUDE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Engine tuning
TICK_INTERVAL=1.0
CANDLE_INTERVAL=300.0
MAX_AGENTS=10
SIGNAL_TIMEOUT=300

# Risk limits
MAX_DAILY_LOSS=10000
MAX_POSITIONS=20

# Monitoring
LOG_LEVEL=INFO
SENTRY_DSN=
