xmbot.online {
    log {
        output file /data/caddy/access.log
    }

    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    reverse_proxy /api/* web:3000
    reverse_proxy /_next/* web:3000
    reverse_proxy /* web:3000
}

www.xmbot.online {
    redir https://xmbot.online{uri} permanent
}

xm1.space {
    log {
        output file /data/caddy/xm1_access.log
    }

    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    reverse_proxy 172.22.0.1:5000
}

www.xm1.space {
    redir https://xm1.space{uri} permanent
}

fractalstrategylab.com {
    log {
        output file /data/caddy/fractal_access.log
    }

    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    reverse_proxy 172.22.0.1:3001
}

www.fractalstrategylab.com {
    redir https://fractalstrategylab.com{uri} permanent
}
